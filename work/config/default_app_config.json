{
  "app": {
    "title": "NVIDIA Time Series Analysis"
  },
  "ui": {
    "language": "en",
    "theme": "dark",
    "window_width": 1280,
    "window_height": 720
  },
  "paths": {
    "data_dir": "work/data",
    "output_dir": "work/output",
    "graphics_dir": "work/graphics",
    "logs_dir": "work/logs"
  },
  "assets": {
    "app_icon": "icons/app.ico",
    "data_icon": "icons/data.png",
    "analysis_icon": "icons/analysis.png",
    "reports_icon": "icons/reports.png",
    "settings_icon": "icons/settings.png",
    "display_icon": "icons/display.png",
    "logo": "images/app_logo.png"
  },
  "reports": {
    "default_export_format": "csv",
    "default_chart_format": "png"
  },
  "analysis": {
    "sma_windows": [5, 20],
    "ema_windows": [12, 26],
    "volatility_window": 20,
    "forecast_horizon": 30
  }
}
